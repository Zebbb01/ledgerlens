# Copy to .env.local for `npm run dev`. With `npm run services` and Azurite running,
# these values point at the local stand-ins; in Azure, Terraform sets the real ones.
MONGODB_URI=mongodb://127.0.0.1:27019/
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
DI_ENDPOINT=http://127.0.0.1:4011
DI_KEY=local
MONTHLY_PAGE_CAP=450

# Optional: category suggestions through the Gemini API free tier (a key from Google AI Studio).
# LLM_API_KEY=
# LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
